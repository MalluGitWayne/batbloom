<?xml version="1.0" encoding="utf-8"?>
<!--
  Batbloom: a glowing night bloom whose two great upper petals are bat wings (sharp leading edge,
  scalloped trailing edge), in front of a golden moon. Everything sits inside the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">

    <!-- moon glow and moon, behind the bloom -->
    <path android:pathData="M54,44m-26,0a26,26 0,1 1,52 0a26,26 0,1 1,-52 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="44" android:gradientRadius="26"
                android:startColor="#55FFE9A8" android:endColor="#00FFE9A8" />
        </aapt:attr>
    </path>
    <path android:pathData="M54,42m-17,0a17,17 0,1 1,34 0a17,17 0,1 1,-34 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="44" android:startY="26" android:endX="64" android:endY="58"
                android:startColor="#FFFFF6D2" android:endColor="#FFF2C46B" />
        </aapt:attr>
    </path>
    <!-- craters -->
    <path android:fillColor="#22B8873A" android:pathData="M47,35m-2.6,0a2.6,2.6 0,1 1,5.2 0a2.6,2.6 0,1 1,-5.2 0" />
    <path android:fillColor="#1AB8873A" android:pathData="M61,31m-1.8,0a1.8,1.8 0,1 1,3.6 0a1.8,1.8 0,1 1,-3.6 0" />

    <!-- stem -->
    <path android:strokeWidth="2.8" android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M54,60Q51.5,70 54,81">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="54" android:startY="60" android:endX="54" android:endY="81"
                android:startColor="#FF4E9E78" android:endColor="#FF2F6B52" />
        </aapt:attr>
    </path>
    <!-- leaves -->
    <path android:pathData="M53,75Q43,75 38,66Q48,65 53,75z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="38" android:startY="66" android:endX="53" android:endY="75"
                android:startColor="#FF8BE0B0" android:endColor="#FF3C8462" />
        </aapt:attr>
    </path>
    <path android:pathData="M54.5,70Q64,70 69,61Q59,60 54.5,70z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="69" android:startY="61" android:endX="54.5" android:endY="70"
                android:startColor="#FF8BE0B0" android:endColor="#FF3C8462" />
        </aapt:attr>
    </path>

    <!-- lower petals -->
    <path android:pathData="M54,55Q43,58 38,68Q48,66 54,60z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="38" android:startY="68" android:endX="54" android:endY="56"
                android:startColor="#FF4A2C8A" android:endColor="#FF8A5BE0" />
        </aapt:attr>
    </path>
    <path android:pathData="M54,55Q65,58 70,68Q60,66 54,60z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="70" android:startY="68" android:endX="54" android:endY="56"
                android:startColor="#FF4A2C8A" android:endColor="#FF8A5BE0" />
        </aapt:attr>
    </path>

    <!-- left bat wing -->
    <path android:pathData="M54,54C46,42 34,33 22,30Q28,37 26,45Q31,42 34,48Q38,45 42,52Q47,50 54,58z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="22" android:startY="30" android:endX="54" android:endY="56"
                android:startColor="#FF5B37B0" android:endColor="#FFA77BFF" />
        </aapt:attr>
    </path>
    <!-- right bat wing -->
    <path android:pathData="M54,54C62,42 74,33 86,30Q80,37 82,45Q77,42 74,48Q70,45 66,52Q61,50 54,58z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="86" android:startY="30" android:endX="54" android:endY="56"
                android:startColor="#FF5B37B0" android:endColor="#FFA77BFF" />
        </aapt:attr>
    </path>
    <!-- wing "fingers" catching the light -->
    <path android:strokeColor="#55E8DCFF" android:strokeWidth="0.7" android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M53,54L26,45M53,55L34,48M53,56L42,52M55,54L82,45M55,55L74,48M55,56L66,52" />
    <!-- bright leading edges -->
    <path android:strokeColor="#88F0E6FF" android:strokeWidth="0.9" android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M54,54C46,42 34,33 22,30M54,54C62,42 74,33 86,30" />

    <!-- top petal -->
    <path android:pathData="M54,30Q62,43 54,56Q46,43 54,30z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="30" android:endX="54" android:endY="56"
                android:startColor="#FFF3ECFF" android:endColor="#FFB08AFF" />
        </aapt:attr>
    </path>

    <!-- glowing heart -->
    <path android:pathData="M54,56m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="56" android:gradientRadius="9"
                android:startColor="#88FFB3D0" android:endColor="#00FFB3D0" />
        </aapt:attr>
    </path>
    <path android:pathData="M54,56m-4.2,0a4.2,4.2 0,1 1,8.4 0a4.2,4.2 0,1 1,-8.4 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="53" android:centerY="55" android:gradientRadius="4.6"
                android:startColor="#FFFFF0F6" android:endColor="#FFFF6FA6" />
        </aapt:attr>
    </path>

    <!-- sparkles -->
    <path android:fillColor="#EEFFFFFF" android:pathData="M30,24l0.9,2.2 2.2,0.9 -2.2,0.9 -0.9,2.2 -0.9,-2.2 -2.2,-0.9 2.2,-0.9z" />
    <path android:fillColor="#CCFFF4C8" android:pathData="M80,58l0.7,1.6 1.6,0.7 -1.6,0.7 -0.7,1.6 -0.7,-1.6 -1.6,-0.7 1.6,-0.7z" />
    <path android:fillColor="#AAFFFFFF" android:pathData="M27,57m-0.9,0a0.9,0.9 0,1 1,1.8 0a0.9,0.9 0,1 1,-1.8 0" />
</vector>
